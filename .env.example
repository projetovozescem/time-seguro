VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Connection string do projeto DEV (pooler, role postgres), usada por
# scripts/test-rls.mjs. Nunca aponte para producao.
DATABASE_URL_DEV=
