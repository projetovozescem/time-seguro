# Modelo. Copie para .env e preencha com o projeto Supabase de DESENVOLVIMENTO.
# O .env real nunca vai para o git.

# As duas unicas variaveis que chegam ao front (docs/TIME_03 §8).
# A service role key fica SO nas Edge Functions.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Connection string do projeto DEV (pooler, role postgres), usada por
# scripts/test-rls.mjs. Nunca aponte para producao.
DATABASE_URL_DEV=

# Management API: aplica migrations, gera tipos e roda os gates de banco.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Admin de desenvolvimento criado por npm run db:bootstrap.
# Sem BOOTSTRAP_SENHA o script sorteia uma senha e imprime uma vez.
BOOTSTRAP_EMAIL=
BOOTSTRAP_SENHA=

# URL do site, usada pelo Auth no link de redefinicao de senha
# (npm run db:configurar grava no projeto). Padrao: http://localhost:3000
SITE_URL=
